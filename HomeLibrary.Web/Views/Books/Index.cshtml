@model BookListViewModel
@{
    ViewData["Title"] = "Книги";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Книги</h1>
    <a class="btn btn-primary" asp-action="Create">Добавить книгу</a>
</div>

<form asp-action="Index" method="get" class="row g-2 mb-3">
    <div class="col-md-7">
        <input asp-for="Query" type="search" class="form-control" placeholder="Поиск…" maxlength="200" />
    </div>
    <div class="col-md-3">
        <select asp-for="SearchIn" asp-items="BookListViewModel.SearchFields" class="form-select"></select>
    </div>
    <div class="col-md-2 d-grid">
        <button type="submit" class="btn btn-outline-secondary">Найти</button>
    </div>
</form>

<table class="table table-hover align-middle">
    <thead>
        <tr>
            <th>Название</th>
            <th>Автор</th>
            <th class="text-end">Год</th>
            <th>Жанр</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var book in Model.Books)
        {
            <tr>
                <td><a asp-action="Details" asp-route-id="@book.Id">@book.Title</a></td>
                <td>@book.Author</td>
                <td class="text-end">@book.PublishYear</td>
                <td>@book.Genre</td>
                <td class="text-end text-nowrap">
                    <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@book.Id">Изменить</a>
                    <form asp-action="Delete" asp-route-id="@book.Id" method="post" class="d-inline"
                          onsubmit="return confirm('Удалить книгу?')">
                        <button type="submit" class="btn btn-sm btn-outline-danger">Удалить</button>
                    </form>
                </td>
            </tr>
        }
        @if (Model.Books.Count == 0)
        {
            <tr><td colspan="5" class="text-center text-muted py-4">Ничего не найдено.</td></tr>
        }
    </tbody>
</table>
