<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Домашняя библиотека</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container">
                <a class="navbar-brand" asp-controller="Books" asp-action="Index">Домашняя библиотека</a>
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item">
                        <a class="nav-link text-dark" asp-controller="Books" asp-action="Index">Все книги</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-dark" asp-controller="Books" asp-action="Create">Добавить книгу</a>
                    </li>
                </ul>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    @{
        // Ошибки проверки формы показываются через alert().
        var errors = ViewContext.ViewData.ModelState.Values.SelectMany(v => v.Errors).Select(e => e.ErrorMessage).ToList();
    }
    @if (errors.Count > 0)
    {
        <script>alert(@Json.Serialize(string.Join("\n", errors)));</script>
    }
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
